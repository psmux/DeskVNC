{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskVNC",
  "version": "0.1.0",
  "identifier": "com.psmux.deskvnc.mobile",
  "build": {
    "beforeDevCommand": "node -e \"const c=require('child_process');const root=c.execSync('git rev-parse --show-toplevel').toString().trim();c.execSync('npm run dev',{cwd:root+'/mobile/ui',stdio:'inherit'})\"",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "node -e \"const c=require('child_process');const root=c.execSync('git rev-parse --show-toplevel').toString().trim();c.execSync('npm run build',{cwd:root+'/mobile/ui',stdio:'inherit'})\"",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeskVNC"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}
