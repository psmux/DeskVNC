{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "session-windows",
  "description": "Narrow capability for per-session viewer windows (labels `session-*`). They get events, window control (fullscreen/resize for the viewer), clipboard sync, and only the session-scoped commands, no host-library mutation, no discovery, no credential management beyond the connect-time password prompt. `allow-destroy` accompanies `allow-close` deliberately: while the window holds a `tauri://close-requested` listener (it does, to flush the exit thumbnail) tauri prevents every close and the JS wrapper finishes it with `destroy()`, without the permission the window could not be closed at all.",
  "windows": ["session-*"],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:window:allow-set-title",
    "core:window:allow-set-size",
    "core:window:allow-set-min-size",
    "core:window:allow-set-position",
    "core:window:allow-set-focus",
    "core:window:allow-set-fullscreen",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "core:window:allow-set-cursor-visible",
    "core:window:allow-set-cursor-grab",

    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",

    "allow-get-host",
    "allow-get-app-setting",
    "allow-touch-connected",
    "allow-save-password",
    "allow-has-password",

    "allow-connect-session",
    "allow-disconnect-session",
    "allow-send-input",
    "allow-set-quality",
    "allow-request-resize",
    "allow-refresh-session",
    "allow-set-view-only",
    "allow-send-clipboard",
    "allow-set-local-clipboard",
    "allow-read-local-clipboard",
    "allow-reconnect-now",
    "allow-release-all-keys",
    "allow-capture-thumbnail",
    "allow-trust-certificate",
    "allow-forget-certificate",
    "allow-provide-credentials",
    "allow-pending-credential-request",
    "allow-cancel-credentials",
    "allow-fullscreen-session",

    "core:webview:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-confirm",

    "allow-files-probe",
    "allow-files-connect",
    "allow-files-disconnect",
    "allow-files-status",
    "allow-files-home",
    "allow-files-list",
    "allow-files-mkdir",
    "allow-files-remove",
    "allow-files-rename",
    "allow-files-upload",
    "allow-files-download",
    "allow-files-cancel",
    "allow-files-local-home",
    "allow-files-local-list",
    "allow-files-local-mkdir",
    "allow-files-local-rename",
    "allow-files-local-remove",

    "allow-capture-start",
    "allow-capture-stop",
    "allow-capture-status",
    "allow-capture-permission-granted",
    "allow-capture-request-permission",

    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "x-apple.systempreferences:*" }]
    }
  ]
}
