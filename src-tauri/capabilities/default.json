{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Capability of the main library window: full core defaults, the UI plugins, and every application command. Deny-by-default per PRD/01 §7, anything not listed here is unavailable to the webview.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-set-fullscreen",
    "core:window:allow-start-dragging",

    "dialog:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "notification:default",
    "store:default",
    "window-state:default",
    "opener:default",

    "allow-list-hosts",
    "allow-get-host",
    "allow-save-host",
    "allow-delete-host",
    "allow-touch-connected",
    "allow-list-groups",
    "allow-save-group",
    "allow-delete-group",
    "allow-list-tags",
    "allow-save-tag",
    "allow-delete-tag",
    "allow-set-host-tags",
    "allow-list-history",
    "allow-get-thumbnail",
    "allow-get-app-setting",
    "allow-set-app-setting",

    "allow-save-password",
    "allow-has-password",
    "allow-delete-password",
    "allow-credential-backend",
    "allow-unlock-credentials",

    "allow-start-discovery",
    "allow-stop-discovery",
    "allow-scan-network",
    "allow-deep-probe",
    "allow-local-subnets",
    "allow-wake-host",

    "allow-connect-session",
    "allow-disconnect-session",
    "allow-send-input",
    "allow-set-quality",
    "allow-request-resize",
    "allow-refresh-session",
    "allow-set-view-only",
    "allow-send-clipboard",
    "allow-reconnect-now",
    "allow-release-all-keys",
    "allow-capture-thumbnail",
    "allow-trust-certificate",
    "allow-forget-certificate",
    "allow-provide-credentials",
    "allow-pending-credential-request",
    "allow-cancel-credentials",
    "allow-open-session-window",
    "allow-fullscreen-session",
    "allow-list-active-sessions",

    "allow-files-probe",
    "allow-files-connect",
    "allow-files-disconnect",
    "allow-files-status",
    "allow-files-home",
    "allow-files-list",
    "allow-files-mkdir",
    "allow-files-remove",
    "allow-files-rename",
    "allow-files-upload",
    "allow-files-download",
    "allow-files-cancel",
    "allow-files-local-home",
    "allow-files-local-list",
    "allow-files-local-mkdir",
    "allow-files-local-rename",
    "allow-files-local-remove",

    "allow-capture-status",
    "allow-capture-permission-granted",
    "allow-capture-request-permission",

    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "x-apple.systempreferences:*" }]
    }
  ]
}
