{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Capability of the main library window: full core defaults, the UI plugins, and every application command. Deny-by-default per PRD/01 §7, anything not listed here is unavailable to the webview. In tabbed view this window also hosts the session viewers themselves, which is why it holds the keyboard-capture commands (`capture-start`/`capture-stop`) that otherwise only a `session-*` window would need, and the `ssh_*` sidecar commands: a terminal opened beside a desktop session in a TAB runs in this window, and without them it was refused before it reached Rust. `ssh_list_local_keys` is this window's alone, since the host editor is.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-set-fullscreen",
    "core:window:allow-start-dragging",

    "dialog:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "notification:default",
    "store:default",
    "window-state:default",
    "opener:default",

    "allow-list-hosts",
    "allow-get-host",
    "allow-save-host",
    "allow-delete-host",
    "allow-touch-connected",
    "allow-list-groups",
    "allow-save-group",
    "allow-delete-group",
    "allow-list-tags",
    "allow-save-tag",
    "allow-delete-tag",
    "allow-set-host-tags",
    "allow-set-hosts-group",
    "allow-add-tag-to-hosts",
    "allow-remove-tag-from-hosts",
    "allow-list-history",
    "allow-get-thumbnail",
    "allow-get-app-setting",
    "allow-about-info",
    "allow-set-app-setting",
    "allow-sync-session-menu",
    "allow-import-rdp-file",
    "allow-import-rdp-files",

    "allow-save-password",
    "allow-has-password",
    "allow-delete-password",
    "allow-credential-backend",
    "allow-unlock-credentials",

    "allow-start-discovery",
    "allow-stop-discovery",
    "allow-scan-network",
    "allow-deep-probe",
    "allow-local-subnets",
    "allow-wake-host",

    "allow-connect-session",
    "allow-disconnect-session",
    "allow-send-input",
    "allow-set-quality",
    "allow-request-resize",
    "allow-refresh-session",
    "allow-set-view-only",
    "allow-set-always-refresh",
    "allow-set-prefer-scancodes",
    "allow-send-clipboard",
    "allow-set-local-clipboard",
    "allow-read-local-clipboard",
    "allow-reconnect-now",
    "allow-release-all-keys",
    "allow-capture-thumbnail",
    "allow-trust-certificate",
    "allow-forget-certificate",
    "allow-provide-credentials",
    "allow-pending-credential-request",
    "allow-cancel-credentials",
    "allow-open-session-window",
    "allow-release-session-claim",
    "allow-fullscreen-session",
    "allow-list-active-sessions",

    "allow-files-probe",
    "allow-files-connect",
    "allow-files-disconnect",
    "allow-files-status",
    "allow-files-home",
    "allow-files-list",
    "allow-files-mkdir",
    "allow-files-remove",
    "allow-files-rename",
    "allow-files-upload",
    "allow-files-download",
    "allow-files-cancel",
    "allow-files-local-home",
    "allow-files-local-list",
    "allow-files-local-mkdir",
    "allow-files-local-rename",
    "allow-files-local-remove",

    "allow-ssh-probe",
    "allow-ssh-list-local-keys",
    "allow-ssh-list-wsl-distros",
    "allow-ssh-connect",
    "allow-ssh-send",
    "allow-ssh-resize",
    "allow-ssh-reconnect-now",
    "allow-ssh-disconnect",

    "allow-capture-start",
    "allow-capture-stop",
    "allow-capture-status",
    "allow-capture-permission-granted",
    "allow-capture-request-permission",

    "allow-agent-status",
    "allow-agent-take-the-wheel",
    "allow-agent-register-with-claude",

    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "x-apple.systempreferences:*" }]
    }
  ]
}
