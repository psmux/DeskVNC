# =============================================================================
# DeskVNCViewer
#
# Grouped by intent. The secrets section is the one that matters: a leaked
# signing key lets someone ship software under this project's identity, and
# revoking it breaks every build already in users' hands.
#
# If a test ever needs a real certificate fixture, whitelist that exact file
# with a negation (for example `!tests/fixtures/server.pem`) rather than
# loosening a pattern below.
# =============================================================================

# ---- Rust / Cargo -----------------------------------------------------------
/target
**/target
*.rs.bk
*.pdb
*.profraw
*.gcda
*.gcno
lcov.info
tarpaulin-report.*
# Generated by scripts/macos-codesign-setup.sh; contains absolute local paths.
/.cargo/config.toml

# ---- Node / frontend --------------------------------------------------------
node_modules/
/ui/node_modules
/ui/dist
/ui/.vite
.vite/
.npm/
.yarn/
.pnp.*
.eslintcache
.stylelintcache
coverage/
.nyc_output/

# ---- Tauri ------------------------------------------------------------------
/src-tauri/gen
/src-tauri/WixTools
/src-tauri/.cargo

# ---- Packaged output --------------------------------------------------------
# Normally under target/, but caught here in case anything is built elsewhere.
*.dmg
*.msi
*.AppImage
*.deb
*.rpm
*.snap
*.app/
*.exe

# ---- Secrets, keys and signing material -------------------------------------
# Never commit any of this.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
*.der
*.jks
*.keystore
*.certSigningRequest
*.p8
*.mobileprovision
*.provisionprofile
*.gpg
id_rsa*
id_ed25519*
id_ecdsa*
known_hosts
secrets.*
*.secret
# Local credential vault written by vnc-store's encrypted-file fallback.
credentials.enc
# Local SQLite host library, in case one is ever created in-tree.
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# ---- Local-only project state -----------------------------------------------
# Internal product specification, kept outside the public repository.
/PRD
# Agent and assistant tooling: session records, transcripts, absolute paths.
.omc/
.claude/
# direnv
.envrc
.direnv/

# ---- Editors ----------------------------------------------------------------
.idea/
*.iml
.vs/
*.sublime-project
*.sublime-workspace
*.code-workspace
.history/
.settings/
.project
.classpath
*.swp
*.swo
*.swn
*~
# VS Code: ignore personal state but allow shared project configuration.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# ---- OS junk ----------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.apdisk
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
# Linux
.directory
.Trash-*
.nfs*

# ---- Logs, scratch and merge artifacts --------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.orig
*.rej
*.bak
*.tmp
tmp/
__pycache__/
